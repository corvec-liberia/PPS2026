const BOOK='1EPIG9JGXwVdq-Jrki8_5eiraqGsOVUhpXvs1r5Gx6i4';
const TAB='EMPLEABILIDAD_2026';
const STATES=['aceptada','rechazada','futura','sin_oferta','pendiente'];
const REASONS=['Continuación de estudios','Otra oportunidad laboral','Motivos personales','Condiciones laborales','Otro motivo'];
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Empleabilidad 2026 · CTP Liberia').addMetaTag('viewport','width=device-width, initial-scale=1');}
function book_(){return SpreadsheetApp.openById(BOOK);}
function rows_(name){const a=book_().getSheetByName(name).getDataRange().getDisplayValues();const h=a.shift();return a.map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])));}
function roster_(){const students=new Map(rows_('ESTUDIANTES').filter(x=>['Asignado','Cumplido','Activo'].includes(x.ESTADO_ESTUDIANTE)).map(x=>[x.ID_ESTUDIANTE,x]));const map=new Map();for(const a of rows_('ASIGNACIONES')){const s=students.get(a.ID_ESTUDIANTE);if(!s||!a.EMPRESA||!['Asignada','Cumplido'].includes(a.ESTADO_ASIGNACION))continue;if(map.has(a.ID_ESTUDIANTE)){map.set(a.ID_ESTUDIANTE,null);continue;}map.set(a.ID_ESTUDIANTE,{id:a.ID_ESTUDIANTE,name:s.NOMBRE_COMPLETO,specialty:s.ESPECIALIDAD,company:a.EMPRESA});}return [...map.values()].filter(Boolean);}
function catalog(pin){const expected=PropertiesService.getScriptProperties().getProperty('ACCESS_CODE');if(!expected||String(pin)!==expected)throw Error('Código de acceso incorrecto');return roster_().map(({id,name,specialty})=>({id,name,specialty}));}
function submit(data){const expected=PropertiesService.getScriptProperties().getProperty('ACCESS_CODE');if(!expected||String(data.pin)!==expected)throw Error('Acceso inválido');if(!STATES.includes(data.status)||data.status==='rechazada'&&!REASONS.includes(data.reason))throw Error('Respuesta inválida');const s=roster_().find(x=>x.id===data.id);if(!s)throw Error('Estudiante no disponible');const lock=LockService.getScriptLock();lock.waitLock(15000);try{const sh=book_().getSheetByName(TAB);if(!sh)throw Error('Almacenamiento no configurado');const receipt=Utilities.getUuid();sh.appendRow([new Date(),s.id,s.name,s.specialty,s.company,data.status,data.status==='rechazada'?data.reason:'',receipt]);SpreadsheetApp.flush();return {ok:true,receipt};}finally{lock.releaseLock();}}
function setup_(){const b=book_();if(!b.getSheetByName(TAB)){const s=b.insertSheet(TAB);s.appendRow(['FECHA_HORA','ID_ESTUDIANTE','NOMBRE_COMPLETO','ESPECIALIDAD','EMPRESA','SITUACION','MOTIVO','RECIBO']);s.setFrozenRows(1);s.getRange('A:A').setNumberFormat('dd/MM/yyyy HH:mm:ss');}}
